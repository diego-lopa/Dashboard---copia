{
  "name": "lorawan-sensor-simulator",
  "version": "1.0.0",
  "description": "Simulador de sensores y gateways LoRaWAN para pruebas de integración — CORNEA by Neutron Insights",
  "main": "mock-lora-devices.js",
  "scripts": {
    "start": "node mock-lora-devices.js",
    "simulate:30min": "node mock-lora-devices.js --interval 1800000 --anomalies",
    "simulate:5min": "node mock-lora-devices.js --interval 300000 --anomalies",
    "simulate:anomalies": "node mock-lora-devices.js --interval 300000 --anomalies",
    "simulate:fast": "node mock-lora-devices.js --interval 5000 --anomalies",
    "simulate:neutrons": "node mock-lora-devices.js --interval 5000 --anomalies --neutrons",
    "load-test": "node mock-lora-devices.js --count 100 --interval 2000"
  },
  "dependencies": {
    "mqtt": "^5.3.4"
  }
}
