# ==============================================================================
# FRONTEND CORNEA (Vite + React) — copiar a `.env` para desarrollo local
#   cp .env.example .env
# ==============================================================================
# URL base de la API backend (debe terminar en /api/v1).
# - Desarrollo local:  http://localhost:8000/api/v1
# - Con Docker Compose: el contenedor nginx redirige /api/ al backend,
#   por lo que en producción compilada se usa VITE_API_URL=/api/v1
#   (ver docker-compose.yml -> frontend -> args).
VITE_API_URL=http://localhost:8000/api/v1
