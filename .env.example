# ==============================================================================
# VARIABLES DE ENTORNO DEL SISTEMA IOT / LORAWAN
# ==============================================================================

# Entorno
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL & TimescaleDB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=changeme_db_password
DATABASE_URL=postgresql://iot:changeme_db_password@postgres:5432/iot?schema=public

# Redis & Colas BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Mosquitto MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=iot
MQTT_PASSWORD=changeme
MQTT_TOPIC_SUBSCRIPTION=application/+/device/+/event/up

# Seguridad & Autenticación API
JWT_SECRET=super_secret_jwt_key_32_characters_minimum_entropy_random_hex
JWT_EXPIRES_IN=24h
API_KEY_INGEST=secret_ingest_key_for_http_gateways_123456

# Puertos y Red
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api/v1

# ChirpStack
CHIRPSTACK_SERVER=chirpstack:8080
CHIRPSTACK_API_SECRET=default_jwt_secret_for_chirpstack_change_in_production
CHIRPSTACK_APPLICATION_ID=1

# Notificaciones y Alertas (Opcionales)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme_smtp
SMTP_FROM="CORNEA IoT Platform <alerts@example.com>"
ALERT_WEBHOOK_URL=https://webhook.site/demo-alerts
